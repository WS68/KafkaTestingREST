{
  "name": "kafka-testing-rest",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP-сервис для публикации и наблюдения записей Kafka",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"tests/**/*.ts\"",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
